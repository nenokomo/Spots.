# Öffentliche Adresse der Website (für Sitemap, Canonical und Link-Vorschauen)
SITE_URL=https://spots.example

# Kontaktformular: Supabase-Projekt, in dem supabase/ops/23_partner_requests.sql eingespielt ist.
# Beide Werte sind öffentlich (Publishable Key), keine Secrets. Ohne diese Werte zeigt das Formular
# stattdessen die Kontakt-Mail an.
PUBLIC_SUPABASE_URL=
PUBLIC_SUPABASE_PUBLISHABLE_KEY=

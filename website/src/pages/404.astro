---
import Base from '../layouts/Base.astro';
import Icon from '../components/Icon.astro';
---
<Base title="Nicht gefunden – Spots" description="Diese Seite gibt es nicht." noindex>
  <section class="section nf">
    <div class="wrap nf__in">
      <p class="eyebrow">Fehler 404</p>
      <h1 class="display"><span>Hier ist</span><span class="accent">nichts los.</span></h1>
      <p class="lead">Diese Seite gibt es nicht. Aber irgendwo in deiner Nähe läuft bestimmt gerade was.</p>
      <div class="nf__cta">
        <a class="btn btn--primary" href="/">Zur Startseite <Icon name="arrow" class="arrow" /></a>
        <a class="btn btn--ghost" href="/veranstalter/">Für Veranstalter</a>
      </div>
    </div>
  </section>
</Base>

<style>
  .nf__in { display: grid; gap: 1.5rem; justify-items: start; min-height: 55vh; align-content: center; }
  .nf .display { font-size: clamp(4rem, 17vw, 10rem); }
  .nf .display span { display: block; }
  .nf__cta { display: flex; flex-wrap: wrap; gap: 0.75rem; }
</style>

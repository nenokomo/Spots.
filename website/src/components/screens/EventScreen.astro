---
// Eventseite wie in der App: Flyer oben, darauf das runde Veranstalterbild mit Story-Ring, Titel, Uhrzeit in Rosa,
// Musikrichtungen, Veranstalter-Karte, „Über das Event“ und unten die feste Leiste mit „Tickets kaufen“ und Merken.
import Icon from '../Icon.astro';
---
<div class="scr evp">
  <div class="evp__poster">
    <span class="fly fly--1 evp__blur"></span>
    <span class="fly fly--1 evp__flyer"><i>Tief<br />gang</i></span>
  </div>
  <div class="ev__btn" style="left:4.6cqw"><Icon name="back" /></div>
  <div class="ev__btn" style="right:4.6cqw"><Icon name="share" /></div>
  <div class="evp__body">
    <span class="evp__ring"><span class="fly fly--2"></span></span>
    <div class="evp__title">Tiefgang</div>
    <div class="evp__when">Heute · 23:00–05:00 Uhr</div>
    <div class="evp__tags"><span>Techno</span><span>Club</span></div>
    <div class="evp__org">
      <span class="fly fly--2"></span>
      <div><small>Veranstalter</small><b>Kellerclub</b></div>
      <span class="evp__profile">Profil<Icon name="arrow" /></span>
    </div>
    <div class="evp__h">Über das Event</div>
    <p class="evp__text">Zwei Floors, Techno bis zum Morgen. Einlass ab 23 Uhr.</p>
  </div>
  <div class="evp__bar"><div class="evp__buy"><Icon name="ticket" />Tickets kaufen</div><div class="evp__save"><Icon name="heart" /></div></div>
</div>

---
import Icon from '../Icon.astro';
---
<div class="scr">
  <div class="ev__poster"><span class="fly fly--1"><i>Tief<br />gang</i></span></div>
  <div class="ev__btn" style="left:4.6cqw"><Icon name="back" /></div>
  <div class="ev__btn" style="right:17.5cqw"><Icon name="share" /></div>
  <div class="ev__btn" style="right:4.6cqw"><Icon name="heart" /></div>
  <div class="ev__sheet">
    <div class="kick">Live · Techno · Club</div>
    <div class="ev__title">Tiefgang</div>
    <div class="facts">
      <div><small>Heute</small><b>23:00</b></div>
      <div><small>Ende</small><b>05:00</b></div>
      <div><small>Entfernung</small><b>0,4 km</b></div>
    </div>
    <div class="ev__snaps">
      <span class="snapdot"><span class="fly fly--2"></span></span>
      <span class="snapdot"><span class="fly fly--4"></span></span>
      <span class="snapdot"><span class="fly fly--1"></span></span>
      12 Live Snaps von heute Nacht
    </div>
  </div>
  <div class="ev__bar"><div class="ev__cta"><Icon name="ticket" />Tickets</div><div class="ev__cta ev__cta--2"><Icon name="route" />Route</div></div>
</div>

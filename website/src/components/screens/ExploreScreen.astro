---
import Icon from '../Icon.astro';
import Tabs from '../Tabs.astro';
---
<div class="scr ex">
  <div class="ex__over">SPOTS. / ENTDECKEN</div>
  <div class="ex__title">Entdecken</div>
  <div class="ex__search"><Icon name="search" />Event, Stadt oder Genre</div>
  <div class="chips"><span class="chip chip--on">Techno</span><span class="chip">Samstag</span><span class="chip">30 km</span></div>
  <div class="ex__h">Als Nächstes<span>Karlsruhe</span></div>
  <div class="hero-card">
    <span class="fly fly--4"></span>
    <div class="hero-card__txt"><div class="kick kick--later kick--plain">Fr., 23:00 · Halle 3</div><div class="etitle" style="font-size:5.2cqw">Neonlicht</div></div>
  </div>
  <div class="tiles">
    <div class="tile"><span class="fly fly--5"><i>Bass<br />line</i></span><div class="etitle">Bassline</div><div class="emeta">Sa., 22:00 · 2,3 km</div></div>
    <div class="tile"><span class="fly fly--6"><i>Live</i></span><div class="etitle">Indie Nacht</div><div class="emeta">Sa., 20:00 · 0,9 km</div></div>
  </div>
  <Tabs active="search" />
</div>

---
// Fragen & Antworten als natives <details>: funktioniert ohne JavaScript und mit der Tastatur.
interface Props { items: { q: string; a: string }[] }
const { items } = Astro.props;
---
<div class="faq">
  {items.map((item, i) => (
    <details class="faq__item" data-reveal style={`--i:${Math.min(i, 4)}`}>
      <summary><span>{item.q}</span><i aria-hidden="true"></i></summary>
      <div class="faq__a"><p set:html={item.a} /></div>
    </details>
  ))}
</div>

<style>
  .faq { border-top: 1px solid var(--line-strong); }
  .faq__item { border-bottom: 1px solid var(--line-strong); }
  summary { list-style: none; cursor: pointer; display: flex; align-items: center; justify-content: space-between; gap: 1.5rem; padding: 1.35rem 0; font-size: clamp(1.0625rem, 2vw, 1.3125rem); font-weight: 650; line-height: 1.3; letter-spacing: -0.01em; transition: color 0.2s var(--ease); }
  summary::-webkit-details-marker { display: none; }
  summary:hover { color: var(--accent-text); }
  summary i { position: relative; flex: none; width: 2.25rem; height: 2.25rem; border-radius: 50%; border: 1px solid var(--line-strong); transition: transform 0.35s var(--ease), background-color 0.25s var(--ease), border-color 0.25s var(--ease); }
  summary i::before, summary i::after { content: ''; position: absolute; left: 50%; top: 50%; width: 0.8rem; height: 1.5px; background: currentColor; translate: -50% -50%; }
  summary i::after { rotate: 90deg; transition: rotate 0.35s var(--ease); }
  details[open] summary i { background: var(--magenta); border-color: var(--magenta); color: #fff; }
  details[open] summary i::after { rotate: 0deg; }
  .faq__a { padding: 0 3.5rem 1.6rem 0; color: var(--text-dim); max-width: 46rem; }
  .faq__a :global(a) { color: var(--text); text-decoration: underline; text-underline-offset: 3px; text-decoration-color: var(--line-strong); }
  .faq__a :global(a:hover) { text-decoration-color: var(--accent-text); }
  @media (max-width: 560px) { .faq__a { padding-right: 0; } }
</style>

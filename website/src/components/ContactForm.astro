---
// Partner-Anfrage. Speichert über die öffentliche Funktion spots_partner_request (supabase/ops/23_partner_requests.sql).
// Ohne Supabase-Konfiguration (PUBLIC_SUPABASE_URL / PUBLIC_SUPABASE_PUBLISHABLE_KEY) bietet das Formular
// stattdessen eine vorausgefüllte E-Mail an. Funktioniert ohne JavaScript nicht – dann erscheint der Mail-Hinweis.
import Icon from './Icon.astro';
import { partnerEmail, todo } from '../config/site';
const url = import.meta.env.PUBLIC_SUPABASE_URL ?? '';
const key = import.meta.env.PUBLIC_SUPABASE_PUBLISHABLE_KEY ?? '';
const mail = partnerEmail();
const kinds = ['Club', 'Bar', 'Event-Crew / Kollektiv', 'Festival / Open Air', 'Konzertveranstalter', 'Sonstiges'];
---
<form class="form" data-form data-url={url} data-key={key} data-mail={mail} novalidate>
  <div class="form__grid">
    <label class="fld">
      <span>Dein Name <b aria-hidden="true">*</b></span>
      <input name="name" autocomplete="name" required maxlength="120" />
      <em class="fld__err" data-err="name">Bitte gib deinen Namen an.</em>
    </label>
    <label class="fld">
      <span>Club, Location oder Crew <b aria-hidden="true">*</b></span>
      <input name="organization" autocomplete="organization" required maxlength="160" />
      <em class="fld__err" data-err="organization">Wie heißt dein Club oder deine Crew?</em>
    </label>
    <label class="fld">
      <span>E-Mail <b aria-hidden="true">*</b></span>
      <input name="email" type="email" autocomplete="email" inputmode="email" required maxlength="200" />
      <em class="fld__err" data-err="email">Bitte gib eine gültige E-Mail-Adresse an.</em>
    </label>
    <label class="fld">
      <span>Stadt <b aria-hidden="true">*</b></span>
      <input name="city" autocomplete="address-level2" required maxlength="120" value="Karlsruhe" />
      <em class="fld__err" data-err="city">In welcher Stadt veranstaltest du?</em>
    </label>
    <label class="fld">
      <span>Telefon <i>(optional)</i></span>
      <input name="phone" type="tel" autocomplete="tel" inputmode="tel" maxlength="40" />
    </label>
    <label class="fld">
      <span>Website oder Instagram <i>(optional)</i></span>
      <input name="website" autocomplete="url" maxlength="300" placeholder="instagram.com/deinclub" />
    </label>
  </div>
  <fieldset class="fld kinds">
    <legend>Was veranstaltest du? <b aria-hidden="true">*</b></legend>
    <div class="kinds__list">
      {kinds.map((k, i) => (
        <label class="kind"><input type="radio" name="kind" value={k} required checked={i === 0} /><span>{k}</span></label>
      ))}
    </div>
  </fieldset>
  <label class="fld">
    <span>Nachricht <i>(optional)</i></span>
    <textarea name="message" rows="4" maxlength="2000" placeholder="Wie oft veranstaltest du, welche Musik, was ist dir wichtig?"></textarea>
  </label>
  <label class="hp" aria-hidden="true">Bitte leer lassen <input name="company_website" tabindex="-1" autocomplete="off" /></label>
  <p class="form__note">Wir nutzen deine Angaben nur, um dir auf deine Anfrage zu antworten. Mehr dazu in der <a href="/datenschutz/">Datenschutzerklärung</a>.</p>
  <div class="form__actions">
    <button class="btn btn--primary" type="submit" data-submit>Anfrage senden <Icon name="arrow" class="arrow" /></button>
    <p class="form__alt">Lieber per Mail? {mail ? <a href={`mailto:${mail}?subject=Partner%20werden%20bei%20Spots`}>{mail}</a> : <span class="ph">{todo('', 'Kontakt-Mail für Veranstalter')}</span>}</p>
  </div>
  <div class="form__msg form__msg--error" data-error role="alert" hidden>
    <strong>Das hat leider nicht geklappt.</strong>
    <span>Bitte versuch es gleich noch einmal{mail ? <> oder schreib uns direkt an <a href={`mailto:${mail}`}>{mail}</a></> : ''}.</span>
  </div>
  <div class="form__done" data-done tabindex="-1" hidden>
    <span class="form__check"><Icon name="check" /></span>
    <h3 class="h3">Danke, deine Anfrage ist da!</h3>
    <p>Wir melden uns innerhalb von zwei Werktagen bei dir – meistens schneller. Bis dahin: Leg dir schon mal den Flyer für dein nächstes Event bereit.</p>
  </div>
  <noscript><p class="form__note">Ohne JavaScript kann das Formular nicht senden. Schreib uns einfach eine Mail{mail ? `: ${mail}` : '.'}</p></noscript>
</form>

<script>
  const EMAIL = /^[^\s@]+@[^\s@]+\.[^\s@]{2,}$/;
  for (const form of document.querySelectorAll<HTMLFormElement>('[data-form]')) {
    const submit = form.querySelector<HTMLButtonElement>('[data-submit]')!;
    const error = form.querySelector<HTMLElement>('[data-error]')!;
    const done = form.querySelector<HTMLElement>('[data-done]')!;
    const field = (name: string) => form.elements.namedItem(name) as HTMLInputElement | null;
    const value = (name: string) => (field(name)?.value ?? '').trim();
    const show = (name: string, invalid: boolean) => {
      const input = field(name);
      if (!input) return;
      input.setAttribute('aria-invalid', String(invalid));
      form.querySelector<HTMLElement>(`[data-err="${name}"]`)?.classList.toggle('is-on', invalid);
    };
    const check = (name: string) => {
      const ok = name === 'email' ? EMAIL.test(value('email')) : value(name).length > 0;
      show(name, !ok);
      return ok;
    };
    const required = ['name', 'organization', 'email', 'city'];
    for (const name of required) field(name)?.addEventListener('blur', () => { if (value(name)) check(name); });
    for (const name of required) field(name)?.addEventListener('input', () => { if (field(name)?.getAttribute('aria-invalid') === 'true') check(name); });

    form.addEventListener('submit', async (event) => {
      event.preventDefault();
      error.hidden = true;
      const results = required.map(check);
      if (results.includes(false)) {
        field(required[results.indexOf(false)])?.focus();
        return;
      }
      if (value('company_website')) { done.hidden = false; form.classList.add('is-done'); return; } // Spam-Falle
      const kind = (form.querySelector<HTMLInputElement>('input[name="kind"]:checked')?.value) ?? 'Sonstiges';
      const payload = {
        p_name: value('name'), p_organization: value('organization'), p_email: value('email'), p_city: value('city'),
        p_kind: kind, p_phone: value('phone') || null, p_website: value('website') || null, p_message: value('message') || null,
      };
      const { url, key, mail } = form.dataset;
      if (!url || !key) {
        // Ohne Backend: vorausgefüllte Mail öffnen.
        if (!mail) { error.hidden = false; return; }
        const body = `Name: ${payload.p_name}\nClub/Crew: ${payload.p_organization}\nArt: ${kind}\nStadt: ${payload.p_city}\nTelefon: ${payload.p_phone ?? '-'}\nWebsite: ${payload.p_website ?? '-'}\n\n${payload.p_message ?? ''}`;
        window.location.href = `mailto:${mail}?subject=${encodeURIComponent(`Partner werden: ${payload.p_organization}`)}&body=${encodeURIComponent(body)}`;
        return;
      }
      submit.disabled = true;
      submit.setAttribute('aria-busy', 'true');
      submit.firstChild!.textContent = 'Wird gesendet … ';
      try {
        const response = await fetch(`${url.replace(/\/$/, '')}/rest/v1/rpc/spots_partner_request`, {
          method: 'POST',
          headers: { 'Content-Type': 'application/json', apikey: key },
          body: JSON.stringify(payload),
        });
        if (!response.ok) throw new Error(String(response.status));
        form.classList.add('is-done');
        done.hidden = false;
        done.focus();
      } catch {
        error.hidden = false;
      } finally {
        submit.disabled = false;
        submit.removeAttribute('aria-busy');
        submit.firstChild!.textContent = 'Anfrage senden ';
      }
    });
  }
</script>

<style>
  .form { position: relative; display: grid; gap: 1.5rem; }
  .form__grid { display: grid; gap: 1.25rem; }
  @media (min-width: 640px) { .form__grid { grid-template-columns: 1fr 1fr; } }
  .fld { display: grid; gap: 0.5rem; border: 0; margin: 0; padding: 0; min-width: 0; }
  .fld > span, .fld legend { font-size: 0.875rem; font-weight: 650; padding: 0; }
  .fld b { color: var(--magenta-hi); font-weight: 650; }
  .fld i { font-style: normal; font-weight: 500; color: var(--text-faint); }
  input:not([type='radio']), textarea {
    width: 100%; min-height: 52px; padding: 0.8rem 1rem; border-radius: var(--radius-sm); border: 1px solid var(--line-strong);
    background: var(--ink-2); color: var(--text); font-size: 1rem; line-height: 1.4;
    transition: border-color 0.2s var(--ease), background-color 0.2s var(--ease), box-shadow 0.2s var(--ease);
  }
  textarea { resize: vertical; min-height: 7.5rem; }
  input::placeholder, textarea::placeholder { color: var(--text-faint); }
  input:hover, textarea:hover { border-color: rgb(243 238 230 / 0.4); }
  input:focus-visible, textarea:focus-visible { outline: none; border-color: var(--magenta-hi); box-shadow: 0 0 0 3px rgb(242 90 211 / 0.25); }
  input[aria-invalid='true'] { border-color: #ff6b8b; }
  .fld__err { display: none; font-style: normal; font-size: 0.8125rem; font-weight: 600; color: #ff8aa5; }
  .fld__err.is-on { display: block; }
  .kinds__list { display: flex; flex-wrap: wrap; gap: 0.5rem; margin-top: 0.5rem; }
  .kind { position: relative; }
  .kind input { position: absolute; opacity: 0; inset: 0; margin: 0; cursor: pointer; }
  .kind span { display: inline-flex; align-items: center; min-height: 44px; padding: 0.45rem 1rem; border-radius: 999px; border: 1px solid var(--line-strong); font-size: 0.9375rem; font-weight: 600; color: var(--text-dim); transition: all 0.2s var(--ease); }
  .kind:hover span { border-color: var(--text); color: var(--text); }
  .kind input:checked + span { background: var(--paper); border-color: var(--paper); color: var(--ink); }
  .kind input:focus-visible + span { outline: 2px solid var(--paper); outline-offset: 3px; }
  .hp { position: absolute; left: -9999px; width: 1px; height: 1px; overflow: hidden; }
  .form__note { font-size: 0.875rem; color: var(--text-faint); }
  .form__note a, .form__alt a, .form__msg a { color: var(--text); text-decoration: underline; text-underline-offset: 3px; text-decoration-color: var(--line-strong); }
  .form__actions { display: flex; flex-wrap: wrap; align-items: center; gap: 1rem 1.5rem; }
  .form__alt { font-size: 0.9375rem; color: var(--text-dim); }
  .ph { color: var(--magenta-hi); font-weight: 600; }
  .form__msg { display: grid; gap: 0.25rem; padding: 1rem 1.25rem; border-radius: var(--radius-sm); font-size: 0.9375rem; }
  .form__msg--error { background: rgb(255 107 139 / 0.1); border: 1px solid rgb(255 107 139 / 0.4); color: #ffc2cf; }
  .form__msg strong { color: #fff; }
  [hidden] { display: none !important; }
  .form__done { display: grid; align-content: center; justify-items: start; gap: 0.9rem; padding: clamp(1.5rem, 4vw, 2.5rem); border-radius: var(--radius); background: var(--ink-2); border: 1px solid var(--line-strong); outline: none; }
  .form.is-done > :not(.form__done) { display: none; }
  .form__done p { color: var(--text-dim); max-width: 30rem; }
  .form__check { display: grid; place-items: center; width: 3.5rem; height: 3.5rem; border-radius: 50%; background: var(--magenta); color: #fff; }
  .form__check :global(svg) { width: 1.75rem; height: 1.75rem; }
  button[aria-busy='true'] { opacity: 0.8; cursor: progress; }
</style>
